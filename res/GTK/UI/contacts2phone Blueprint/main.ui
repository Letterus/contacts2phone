<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="GtkWindow" id="mainWindow">
    <property name="default-width">720</property>
    <property name="default-height">480</property>
    <property name="title" translatable="yes">Transfer contacts to SNOM IP phone base</property>
    <child>
      <object class="GtkPaned" id="hpaned">
        <property name="orientation">0</property>
        <child>
          <object class="AdwToolbarView">
            <property name="width-request">360</property>
            <property name="bottom-bar-style">1</property>
            <property name="content">
              <object class="GtkScrolledWindow" id="scrolledAddressbookWindow">
                <child>
                  <object class="GtkListBox">
                    <property name="selection-mode">1</property>
                    <property name="show-separators">true</property>
                    <child>
                      <object class="GtkListBoxRow" id="addressBooksList">
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">0</property>
                            <property name="margin-top">12</property>
                            <property name="margin-bottom">12</property>
                            <property name="margin-start">12</property>
                            <property name="margin-end">12</property>
                            <property name="halign">1</property>
                            <child>
                              <object class="GtkImage">
                                <property name="icon-name">address-book-new</property>
                                <property name="margin-end">12</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Default AddressBook</property>
                                <style>
                                  <class name="heading"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </property>
            <child type="bottom">
              <object class="GtkActionBar">
                <child type="end">
                  <object class="GtkButton" id="refreshButton">
                    <property name="label" translatable="yes">Refresh</property>
                    <property name="icon-name">view-refresh</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwToolbarView">
            <property name="width-request">360</property>
            <property name="content">
              <object class="GtkScrolledWindow" id="scrolledFormWindow">
                <child>
                  <object class="GtkBox">
                    <property name="orientation">1</property>
                    <property name="margin-top">32</property>
                    <property name="margin-bottom">12</property>
                    <property name="margin-start">12</property>
                    <property name="margin-end">12</property>
                    <property name="halign">3</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">SNOM IP phone base</property>
                        <property name="margin-bottom">20</property>
                        <style>
                          <class name="title-4"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkGrid" id="form">
                        <property name="margin-top">12</property>
                        <property name="margin-bottom">12</property>
                        <property name="margin-start">12</property>
                        <property name="margin-end">12</property>
                        <property name="row-spacing">12</property>
                        <property name="column-spacing">12</property>
                        <child>
                          <object class="GtkLabel" id="ipAddressLabel">
                            <property name="label" translatable="yes">IP address:</property>
                            <layout>
                              <property name="row">0</property>
                              <property name="column">0</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkEntry" id="ipAddressEntry">
                            <layout>
                              <property name="row">0</property>
                              <property name="column">1</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="usernameLabel">
                            <property name="label" translatable="yes">User name:</property>
                            <layout>
                              <property name="row">1</property>
                              <property name="column">0</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkEntry" id="usernameEntry">
                            <layout>
                              <property name="row">1</property>
                              <property name="column">1</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="passwordLabel">
                            <property name="label" translatable="yes">User password:</property>
                            <layout>
                              <property name="row">2</property>
                              <property name="column">0</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkEntry" id="passwordEntry">
                            <property name="visibility">false</property>
                            <property name="input-purpose">8</property>
                            <layout>
                              <property name="row">2</property>
                              <property name="column">1</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="testButton">
                            <property name="name">TestButton</property>
                            <property name="label" translatable="yes">Test</property>
                            <property name="use-underline">true</property>
                            <layout>
                              <property name="row">3</property>
                              <property name="column">0</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="transferButton">
                            <property name="name">TransferButton</property>
                            <property name="label" translatable="yes">Transfer</property>
                            <property name="use-underline">true</property>
                            <style>
                              <class name="suggested-action"/>
                            </style>
                            <layout>
                              <property name="row">3</property>
                              <property name="column">1</property>
                            </layout>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>